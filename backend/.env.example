# Chronomind Backend Environment Variables
PROJECT_NAME="Chronomind - AI Dynamic Project Planner"
DATABASE_URL="sqlite:///./chronomind.db"

# LLM Providers (OpenAI or Google Gemini)
# Leave blank to use Chronomind's built-in intelligent heuristic engine
GEMINI_API_KEY=""
OPENAI_API_KEY=""

# AI Engine selection: "auto", "gemini", or "openai"
DEFAULT_AI_PROVIDER="auto"
GEMINI_MODEL="gemini-1.5-flash"
OPENAI_MODEL="gpt-4o-mini"

# CORS configuration
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000","*"]
